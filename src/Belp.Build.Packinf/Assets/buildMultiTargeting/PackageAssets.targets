<Project ToolsVersion="15.0" InitialTargets="_CheckPackageAssets" TreatAsLocalProperty="_contentFiles_any;_contentFiles_cs" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="_CheckPackageAssets" Condition="'@(PackageAsset)' != ''">
    <Error Condition="'%(PackageAsset.Extension)' == ''" Code="BLP4011" Text="Extension-less files are not supported by PackageAsset." File="%(PackageAsset.FullPath)" />
  </Target>



  <ItemGroup>
    <None Remove="@(PackageAsset)" />
    <None Include="@(PackageAsset)">
      <Pack>true</Pack>

      <PackagePath Condition="'%(PackagePath)' == ''">content;contentFiles</PackagePath>

      <!--
        Expands contentFiles/ to contentFiles/{language}/{tfm}
        The expansion has an implementation in NuGet, but can only be triggered
        for some files, so it has to be reimplemented here.
      -->
      <PackagePath Condition="'%(BuildAction)' == 'Compile'">$([System.Text.RegularExpressions.Regex]::Replace('%(PackagePath)', '(?&lt;=\A|;)contentFiles[/\\]*(?=;|\Z)', '$(_contentFiles_cs)'))</PackagePath>
      <PackagePath Condition="'%(BuildAction)' != 'Compile'">$([System.Text.RegularExpressions.Regex]::Replace('%(PackagePath)', '(?&lt;=\A|;)contentFiles[/\\]*(?=;|\Z)', '$(_contentFiles_any)'))</PackagePath>

      <_TargetFileName Condition="'%(Filename)' == '_Package'">$(PackageId)</_TargetFileName>
      <!--
        If RecursiveDir contains a directory named _Package,
        Then force expansion of PackagePath and replacement of _Package
      -->
      <_TargetFileName Condition="'%(_TargetFileName)' == '' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(RecursiveDir)', '(?&lt;=\A|[\\/])_Package(?=[\\/]|\Z)'))">%(Filename)</_TargetFileName>
      <PackagePath Condition="'%(_TargetFileName)' != '' And '%(Extension)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('%(PackagePath)', '(?&lt;!;|[^/\\]$([System.Text.RegularExpressions.Regex]::Escape(%(Extension))))(?=;|\Z)', '/%(RecursiveDir)%(_TargetFileName)%(Extension)'))</PackagePath>

      <!-- Replace _Package in directory names with PackageId -->
      <PackagePath>$([System.Text.RegularExpressions.Regex]::Replace('%(PackagePath)', '(?&lt;=\A|[\\/])_Package(?=[\\/]|\Z)', '$(PackageId)'))</PackagePath>
      <!-- Replace \ with /, and squash consecutive slashes into / -->
      <PackagePath>$([System.Text.RegularExpressions.Regex]::Replace('%(PackagePath)', '[\\/]{2,}|\\', '/'))</PackagePath>
    </None>
  </ItemGroup>



  <!-- Fix PackagePaths containing contentFiles/. -->
  <!-- Pre-generate paths for contentFiles. -->
  <Choose>
    <!-- Single-Targeting Build -->
    <When Condition="'$(TargetFrameworks)' == ''">
      <PropertyGroup>
        <_contentFiles_any>contentFiles/any/$(TargetFramework)/</_contentFiles_any>
        <_contentFiles_cs>contentFiles/cs/$(TargetFramework)/</_contentFiles_cs>
      </PropertyGroup>
    </When>

    <!-- Multi-Targeting Build -->
    <Otherwise>
      <!-- Current Context: Outer Build -->
      <!-- Inner builds do not run pack(2024 June 07) -->
      <PropertyGroup>
        <_contentFiles_any>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFrameworks)', '(?&lt;=\A|;)[^;]+(?=;|\Z)', 'contentFiles/any/$0/'))</_contentFiles_any>
        <_contentFiles_cs>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFrameworks)', '(?&lt;=\A|;)[^;]+(?=;|\Z)', 'contentFiles/cs/$0/'))</_contentFiles_cs>
      </PropertyGroup>
    </Otherwise>
  </Choose>

</Project>
